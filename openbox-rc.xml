<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <theme>
    <name>Clearlooks</name>
    <!-- Titlebar layout: LC (No minimize 'I') -->
    <titleLayout>LC</titleLayout>
    <keepBorder>no</keepBorder>
    <animateIconify>no</animateIconify>
  </theme>

  <!-- Desktops: Single desktop only -->
  <desktops>
    <number>1</number>
    <firstdesk>1</firstdesk>
    <names>
      <name>HeavenOS-App</name>
    </names>
  </desktops>

  <resize>
    <drawContents>yes</drawContents>
    <popupShow>Never</popupShow>
  </resize>

  <!-- Keyboard Shortcuts -->
  <keyboard>
    <!-- Ctrl + Tab: Switch to Next Allowed App Window -->
    <keybind key="C-Tab">
      <action name="NextWindow">
        <finalactions>
          <action name="Focus"/>
          <action name="Raise"/>
          <action name="Unshade"/>
          <action name="Maximize"/>
        </finalactions>
      </action>
    </keybind>

    <!-- Ctrl + Shift + Tab: Switch to Previous Allowed App Window -->
    <keybind key="C-S-Tab">
      <action name="PreviousWindow">
        <finalactions>
          <action name="Focus"/>
          <action name="Raise"/>
          <action name="Unshade"/>
          <action name="Maximize"/>
        </finalactions>
      </action>
    </keybind>

    <!-- Also allow standard Alt + Tab to switch between allowed apps -->
    <keybind key="A-Tab">
      <action name="NextWindow">
        <finalactions>
          <action name="Focus"/>
          <action name="Raise"/>
          <action name="Unshade"/>
          <action name="Maximize"/>
        </finalactions>
      </action>
    </keybind>

    <keybind key="A-S-Tab">
      <action name="PreviousWindow">
        <finalactions>
          <action name="Focus"/>
          <action name="Raise"/>
          <action name="Unshade"/>
          <action name="Maximize"/>
        </finalactions>
      </action>
    </keybind>

    <!-- Trap keys that could escape or minimize -->
    <keybind key="W-d"><action name="Execute"><command>/bin/true</command></action></keybind>
    <keybind key="W-m"><action name="Execute"><command>/bin/true</command></action></keybind>
    <keybind key="A-F9"><action name="Execute"><command>/bin/true</command></action></keybind>
    <keybind key="A-space"><action name="Execute"><command>/bin/true</command></action></keybind>
  </keyboard>

  <!-- Mouse actions: Disable desktop right-click menu -->
  <mouse>
    <context name="Root">
      <!-- Desktop clicking does nothing -->
    </context>
    
    <context name="Titlebar">
      <mousebind button="Left" action="DoubleClick">
        <action name="Focus"/>
      </mousebind>
    </context>

    <context name="Iconify">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
      </mousebind>
    </context>
  </mouse>

  <!-- Applications Rules: Enforce all open windows to stay Maximized with no minimize -->
  <applications>
    <application class="*">
      <decor>yes</decor>
      <maximized>yes</maximized>
      <iconic>no</iconic>
      <skip_taskbar>yes</skip_taskbar>
      <skip_pager>yes</skip_pager>
    </application>

    <application class="Google-chrome">
      <maximized>yes</maximized>
      <decor>yes</decor>
      <iconic>no</iconic>
    </application>

    <application class="Blender">
      <maximized>yes</maximized>
      <decor>yes</decor>
      <iconic>no</iconic>
    </application>
  </applications>
</openbox_config>
