<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <theme>
    <name>Clearlooks</name>
    <!-- Titlebar layout: N (Icon/Title), L (Label), I (Minimize/Iconify), M (Maximize), C (Close) -->
    <!-- Minimize button is enabled as requested! -->
    <titleLayout>NLIMC</titleLayout>
    <keepBorder>yes</keepBorder>
    <animateIconify>yes</animateIconify>
  </theme>

  <!-- Single Desktop -->
  <desktops>
    <number>1</number>
    <firstdesk>1</firstdesk>
    <names>
      <name>HeavenOS</name>
    </names>
  </desktops>

  <resize>
    <drawContents>yes</drawContents>
    <popupShow>Never</popupShow>
  </resize>

  <!-- Keyboard Shortcuts -->
  <keyboard>
    <!-- Ctrl + Tab: Switch App -->
    <keybind key="C-Tab">
      <action name="NextWindow">
        <finalactions>
          <action name="Focus"/>
          <action name="Raise"/>
          <action name="Unshade"/>
          <action name="Maximize"/>
        </finalactions>
      </action>
    </keybind>

    <!-- Alt + Tab: Switch App -->
    <keybind key="A-Tab">
      <action name="NextWindow">
        <finalactions>
          <action name="Focus"/>
          <action name="Raise"/>
          <action name="Unshade"/>
          <action name="Maximize"/>
        </finalactions>
      </action>
    </keybind>

    <!-- BLOCK Terminal shortcuts completely -->
    <keybind key="C-A-t">
      <action name="Execute"><command>/bin/true</command></action>
    </keybind>
    <keybind key="C-A-T">
      <action name="Execute"><command>/bin/true</command></action>
    </keybind>
    <keybind key="F12">
      <action name="Execute"><command>/bin/true</command></action>
    </keybind>

    <!-- Block OS Escapes -->
    <keybind key="W-d"><action name="Execute"><command>/bin/true</command></action></keybind>
    <keybind key="W-m"><action name="Execute"><command>/bin/true</command></action></keybind>
  </keyboard>

  <!-- Mouse actions -->
  <mouse>
    <context name="Root">
      <!-- Right-click desktop menu completely disabled (No terminal or menu access) -->
    </context>
  </mouse>

  <!-- Window Rules: Keep apps maximized by default -->
  <applications>
    <application class="*">
      <decor>yes</decor>
      <maximized>yes</maximized>
      <skip_taskbar>yes</skip_taskbar>
      <skip_pager>yes</skip_pager>
    </application>
  </applications>
</openbox_config>
